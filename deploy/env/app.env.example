# ---------------------------------------------------------------------------
# Runtime environment for the container  ->  copy to  <APP_DIR>/app.env
#
#   sudo install -m 600 -o ubuntu -g ubuntu app.env.example /opt/ai-petition-generator/app.env
#
# This file lives ON THE EC2 HOST ONLY. It is never committed, never written
# by CI, and never copied into a Docker image layer (see .dockerignore).
#
# ⚠️  THIS IS NOT backend/.env.example.
#
# Do not use backend/.env.example as a production template. It has drifted
# from backend/app/config.py — it still specifies SARVAM_TTS_MODEL=bulbul:v2
# and SARVAM_TTS_SPEAKER=anushka, both of which are retired and answer
# HTTP 400 "has been deprecated". config.py's own comment calls the current
# values "load-bearing". Every value below was taken from config.py directly.
#
# The service starts with NONE of the optional settings configured. Each
# missing piece degrades exactly one feature and is reported at startup and
# on /api/health.
# ---------------------------------------------------------------------------

# --- Service ----------------------------------------------------------------
# HOST=0.0.0.0 applies inside the container only. The port is published to the
# host loopback by docker-compose.yml, so this is not a public bind.
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json

# Must match the compose volume mount path exactly.
DATA_DIR=/app/backend/var

# The browser talks to the same origin it was served from (the frontend uses
# only relative URLs), so CORS is not required for the application to work.
# Set it to the real public origin, or leave it empty.
#
# ⛔ NEVER set this to "*". CORSMiddleware is configured with
# allow_credentials=True in backend/app/main.py, and "*" would make Starlette
# reflect the caller's origin back, defeating same-origin protection entirely.
CORS_ORIGINS=https://CHANGE-ME.example.com

# --- Operator screen --------------------------------------------------------
# ⛔ MANDATORY IN THIS DEPLOYMENT. Not optional.
#
# backend/app/api/operator.py grants access when OPERATOR_TOKEN is unset and
# the request comes from loopback. Behind Nginx (and behind Docker's bridge)
# EVERY request appears to come from a local address, so an unset token turns
# a fail-closed control into a fail-open one and publishes the operator screen.
#
# Generate with:  openssl rand -hex 32
OPERATOR_TOKEN=CHANGE-ME-openssl-rand-hex-32

# --- Documents --------------------------------------------------------------
PDF_ENGINE=libreoffice
SOFFICE_PATH=/usr/bin/soffice

# ⛔ MANDATORY. config.py defaults to "Nirmala UI", which is a WINDOWS font.
# On Linux that default produces a PDF whose Tamil is drawn as empty boxes —
# a document the citizen cannot read. The image installs the repository's own
# bundled Noto Sans Tamil TTFs system-wide for exactly this value.
LETTER_FONT=Noto Sans Tamil

# --- Language model ---------------------------------------------------------
# Default posture is on-premise and is preserved here. The service collects
# every detail, validates it, and produces the petition with standard wording
# without any model at all. The model only improves the opening paragraph.
#
# ALLOW_EXTERNAL_AI must be true before ANY hosted provider is used, so the
# mere presence of an API key cannot opt this deployment into egress.
ALLOW_EXTERNAL_AI=false
LLM_PROVIDER=off

# Only uncomment these if external AI has been formally approved for this
# deployment. Aadhaar is excluded from prompts at source regardless.
# ALLOW_EXTERNAL_AI=true
# LLM_PROVIDER=gemini
# GEMINI_API_KEYS=
# ANTHROPIC_API_KEY=
# GROQ_API_KEYS=
# OPENROUTER_API_KEYS=

# --- Speech (optional; audio leaves the machine when enabled) ---------------
STREAM_ASR_PROVIDER=off
TTS_PROVIDER=off
# SARVAM_API_KEYS=
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=

# --- Government knowledge layer --------------------------------------------
# Advisory only; never writes a word of the petition. An empty corpus is a
# normal, supported state — the analysis panel simply stays hidden.
# Load documents with: docker compose exec app python scripts/ingest.py ...
KNOWLEDGE_ENABLED=true
