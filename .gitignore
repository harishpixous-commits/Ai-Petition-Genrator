# Credentials. The .env holds live API keys for Anthropic, Gemini, Groq and
# Sarvam. .env.example carries the same settings with every value left empty,
# and that IS committed — it is the documentation for what has to be set.
.env
.env.*
!.env.example

# Local state. This is the important one.
#
# backend/var holds the checkpoint database, and a checkpoint is the whole
# petition: the citizen's name, address, Aadhaar number and the grievance in
# their own words. The generated Word and PDF files beside it carry the same
# details, and so does anything a citizen uploaded as an attachment. None of it
# belongs in a repository, and no rule here should ever be relaxed to "just
# this once" for a sample.
var/
backend/var/

# Screenshots from the browser checks. Regenerable by definition, and the
# same rule as var/ applies for the same reason: these are pictures OF
# petitions. The preview harness uses fictional samples today, and the
# acceptance script writes to a temporary data directory — but a capture
# taken one day against a real machine would land here looking exactly like
# the rest, and nobody would notice it in a diff of binary files.
artifacts/
backend/artifacts/

# Virtual environments and caches.
.venv/
venv/
backend/.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Provider credentials set from the operator screen. It lives in the data
# directory, which is already ignored — but a credentials file is worth a rule
# of its own, in case DATA_DIR is ever pointed somewhere inside the repository.
providers.json

# Databases, wherever they end up.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Node, if a tool ever pulls it in. The application itself has no build step.
node_modules/

# Editor and operating-system leftovers.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
