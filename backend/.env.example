# LOCAL DEVELOPMENT. Copy to .env and fill in what applies. Never commit .env.
#
# NOT the production template. A deployment takes its settings from
# `deploy/env/app.env.example`, which is copied to /opt/ai-petition-generator/
# app.env ON THE HOST and is never committed, never written by CI and never
# baked into an image layer. Using this file to configure a server is how a
# deployment ends up with retired provider settings: the two drifted apart
# once already, and the values below were wrong for long enough to ship.
#
# The service runs with NONE of this set. Without a language model it still
# collects every detail, validates it, and produces the petition using the
# standard wording; the model only improves the opening paragraph.

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json                 # json for a log collector, text for a terminal
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Session checkpoints and generated documents live here.
# DATA_DIR=./var

# ---------------------------------------------------------------------------
# Language model
#
# Default posture is on-premise. ALLOW_EXTERNAL_AI must be 'true' before any
# hosted provider is used, so that the mere presence of an API key below can
# never opt a government workspace into sending citizen text off the machine.
# ---------------------------------------------------------------------------
ALLOW_EXTERNAL_AI=false
LLM_PROVIDER=auto               # auto | anthropic | openrouter | groq | gemini | ollama | off
LLM_CHAIN=anthropic,openrouter,groq,gemini,ollama

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENROUTER_API_KEYS=            # comma-separated; rotated on an auth or quota failure
OPENROUTER_MODELS=nex-agi/nex-n2.5-mini:free
GROQ_API_KEYS=
GROQ_MODELS=qwen/qwen3.8-27b
GEMINI_API_KEYS=
# Tried in order. These endpoints answer 503 under load often enough that a
# second and third model earn their place.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# On-premise. Nothing leaves the machine. This is the deployment posture for a
# departmental rollout: set LLM_CHAIN=ollama and leave ALLOW_EXTERNAL_AI=false.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

# A voice turn is latency-critical and is bounded hard. Composition happens once,
# after confirmation, while the citizen watches a progress indicator.
UNDERSTAND_TIMEOUT_MS=6000
UNDERSTAND_BUDGET_MS=9000
COMPOSE_TIMEOUT_MS=25000
COMPOSE_BUDGET_MS=90000

# ---------------------------------------------------------------------------
# Speech to text
#
# Audio leaves the machine while a hosted provider is configured. That is stated
# on screen through /api/health, not buried here.
# nova-2 has NO Tamil and answers HTTP 400 for it. Do not change nova-3 without
# checking Tamil still works.
# ---------------------------------------------------------------------------
STREAM_ASR_PROVIDER=auto        # auto | deepgram | assemblyai | off
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_API_KEY=
ASR_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# Spoken replies and Tamil translation (both optional)
# ---------------------------------------------------------------------------
TTS_PROVIDER=auto               # auto | sarvam | off
SARVAM_API_KEYS=                # comma-separated; used for both TTS and translation
# Both load-bearing, and both were wrong here. bulbul:v2 is retired and
# answers HTTP 400 "has been deprecated"; anushka is not a v3 speaker. These
# now match app/config.py, which is the only authority on them.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=ishita

# Local NLLB worker, used only if Sarvam is unavailable. Point at the worker
# script and the model directory from the existing runtime assets.
NLLB_WORKER=
NLLB_MODEL_DIR=

# ---------------------------------------------------------------------------
# Documents
#
# PDF goes through LibreOffice because Tamil needs OpenType shaping — vowel
# signs reorder around the consonant they attach to — and a pure-Python PDF
# writer produces Tamil that is subtly wrong. Word can shape correctly too, but
# driving it means an interactive Office install on the server, so it is
# development-only and never selected by default. Without a converter the
# service produces DOCX and says so on /api/health.
# ---------------------------------------------------------------------------
# libreoffice  the supported engine (default)
# word         Windows only, for development; must be chosen explicitly
# auto         LibreOffice, falling back to Word
# off          DOCX only
PDF_ENGINE=libreoffice
SOFFICE_PATH=soffice
LETTER_FONT=Nirmala UI          # carries Tamil on Windows; use Noto Sans Tamil on Linux

# The operator status screen at /operator. With a token set it is
# required from any address; with none it answers only on loopback,
# which is the safe default for a machine nobody has configured yet.
OPERATOR_TOKEN=
